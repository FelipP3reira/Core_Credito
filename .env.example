# Copie para .env e preencha. O .env nao vai para o git.
#
# Os nomes com duplo sublinhado sao lidos direto pela configuracao do .NET:
# ConnectionStrings__Banco vira ConnectionStrings:Banco sem nenhum codigo de mapeamento.

# Senha do SA, usada pelo docker compose ao criar o container. Exigencia da imagem:
# 8+ caracteres com maiuscula, minuscula, numero e simbolo — sem isso o banco nao sobe.
SENHA_SA=troque-esta-senha-Aa1!

# A mesma senha aparece aqui dentro da string de conexao. TrustServerCertificate fica
# ligado porque o container gera certificado proprio; em producao isso sai.
ConnectionStrings__Banco=Server=localhost,1433;Database=CoreCredito;User Id=sa;Password=troque-esta-senha-Aa1!;Encrypt=True;TrustServerCertificate=True

# Segredo do HMAC que gera o hash de busca do CPF. Trocar invalida a busca por CPF de
# todas as propostas ja gravadas: e valor de infraestrutura, nao de deploy.
# Gere com: openssl rand -base64 48
ProtecaoDeCpf__Pepper=

# Chave AES de 256 bits, em base64, que cifra o CPF em repouso.
# Gere com: openssl rand -base64 32
ProtecaoDeCpf__ChaveDeCifra=

# Onde fica a Plataforma Bancaria, que guarda a conta do cliente. O desembolso do
# contrato e a cobranca das parcelas passam por ela.
ContaBancaria__BaseUrl=http://localhost:5240
ContaBancaria__TempoLimiteEmSegundos=10
