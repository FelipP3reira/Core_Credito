# Copie para .env e preencha. O .env nao vai para o git.

# Senha do SA do SQL Server em container. Exigencia da imagem: 8+ caracteres
# com maiuscula, minuscula, numero e simbolo — o container nao sobe sem isso.
SENHA_SA=troque-esta-senha-Aa1!

# Pepper do HMAC que gera o CpfHash. Trocar este valor invalida a busca por CPF
# de todas as propostas ja gravadas, entao e valor de infraestrutura, nao de deploy.
# Gere com: openssl rand -base64 48
PEPPER_CPF=

# Chave usada pelo Data Protection para cifrar o CPF em repouso.
# Gere com: openssl rand -base64 48
CHAVE_CIFRA_CPF=
